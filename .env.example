# --- LLM: any OpenAI-compatible endpoint (OpenAI, OpenRouter, your own gateway) ---
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
MODEL_TRIAGE=gpt-5.4-nano           # junk filter: batches of 25 leads, cheap
MODEL_RESEARCH=gpt-5.4-mini         # company website analysis
MODEL_WRITER=claude-sonnet-5.5      # proposal copy
MODEL_CRITIC=gpt-5.4-mini           # strict editor for the draft

# --- Lead sources ---
# APIFY_TOKEN=                      # console.apify.com → Settings → API & Integrations
# GITHUB_TOKEN=                     # falls back to `gh auth token`

# --- Email verification (optional) ---
# REACHER_URL=http://127.0.0.1:8080 # self-hosted reacherhq/check-if-email-exists

# --- Sender ---
SENDER_NAME=Alex                    # signature for Russian-language emails
SENDER_NAME_EN=Alex                 # signature for English-language emails
SENDER_TITLE=Founder, Example Inc.
SENDER_EMAIL=alex@outreach-example.com   # mailbox on a SEPARATE cold-outreach domain
REPLY_TO=sales@example.com

# --- SMTP ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SEND_LIVE=0                         # 0 = write emails to out/outbox/*.eml, nothing is sent
DAILY_LIMIT=20
SEND_DELAY_SEC_MIN=60
SEND_DELAY_SEC_MAX=180
